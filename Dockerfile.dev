FROM hexpm/elixir:1.18.3-erlang-27.3.4.6-debian-bookworm-20260202-slim

ARG TARGETARCH
ARG ZIG_VERSION=0.15.1

ENV LANG=C.UTF-8

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    file \
    git \
    qemu-user-static \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
  && case "${arch}" in \
      amd64) zig_arch="x86_64" ;; \
      arm64) zig_arch="aarch64" ;; \
      *) echo "Unsupported container architecture: ${arch}" >&2; exit 1 ;; \
    esac \
  && curl -fL --retry 3 --retry-all-errors "https://ziglang.org/download/${ZIG_VERSION}/zig-${zig_arch}-linux-${ZIG_VERSION}.tar.xz" -o /tmp/zig.tar.xz \
  && tar -xJf /tmp/zig.tar.xz -C /opt \
  && ln -s "/opt/zig-${zig_arch}-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig \
  && rm /tmp/zig.tar.xz \
  && zig version

WORKDIR /workspace
